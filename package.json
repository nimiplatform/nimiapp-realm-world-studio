{
  "name": "nimiapp-realm-world-studio",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1451 --strictPort",
    "dev:shell": "nimi-app dev",
    "build:renderer": "vite build",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck": "pnpm run typecheck:renderer",
    "build": "pnpm run typecheck && pnpm run build:renderer",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec",
    "check:spec-consistency": "pnpm run spec:authority:check",
    "i18n:check": "npx tsx scripts/check-realm-world-studio-i18n.ts",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "test": "vitest run && node --test test/platform-build-entry.test.mjs",
    "test:watch": "vitest",
    "validate": "nimi-app check",
    "pack": "nimi-app pack",
    "check": "pnpm run validate && pnpm run check:spec-consistency && pnpm run i18n:check && pnpm run i18n:audit && pnpm run typecheck && pnpm run lint && pnpm run test",
    "nimicoding": "nimicoding",
    "nimicoding:doctor": "nimicoding doctor",
    "sync": "nimi-app sync",
    "dev:web": "nimi-app dev --platform web",
    "dev:web-renderer": "vite --config vite.web.config.ts --mode web",
    "build:web": "pnpm run typecheck:renderer && vite build --config vite.web.config.ts --mode web",
    "build:web:release": "pnpm run typecheck:renderer && vite build --config vite.web.config.ts --mode web-release"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.3.8",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0",
    "@nimiplatform/app-tools": "^0.16.0-rc.13",
    "@nimiplatform/nimi-coding": "0.7.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "i18next": "^26.4.2",
    "lucide-react": "^0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.0",
    "react-router-dom": "^7.15.1",
    "scheduler": "^0.27.0",
    "zustand": "^5.0.13",
    "@nimiplatform/sdk": "^0.24.0-rc.10",
    "@nimiplatform/kit": "^0.24.0-rc.16"
  },
  "author": "Nimi Team",
  "license": "MIT"
}
